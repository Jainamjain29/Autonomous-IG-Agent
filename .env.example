# Copy to .env and fill in. .env is gitignored.
# For META_ACCESS_TOKEN, IG_USER_ID and GEMINI_API_KEY, values here take priority
# over anything saved in the dashboard's Settings tab.

# Instagram Graph API
META_ACCESS_TOKEN=
IG_USER_ID=

# graph.facebook.com (Facebook Login) or graph.instagram.com (Instagram Login).
# Resumable upload is only documented for graph.facebook.com.
GRAPH_HOST=graph.facebook.com
GRAPH_VERSION=v26.0

# resumable (upload the local file directly) or ngrok (expose via tunnel + video_url)
PUBLISH_MODE=resumable

# Google Gemini
GEMINI_API_KEY=
