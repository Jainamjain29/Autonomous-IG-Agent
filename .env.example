# Copy to .env and fill in. .env is gitignored.
# For META_ACCESS_TOKEN, IG_USER_ID and GEMINI_API_KEY, values here take priority
# over anything saved in the dashboard's Settings tab.

# Instagram Graph API
META_ACCESS_TOKEN=
IG_USER_ID=
# Meta Access Token Expiration (ISO 8601 UTC, e.g. 2026-11-01T00:00:00Z).
# Value comes from Meta's Access Token Debugger: https://developers.facebook.com/tools/debug/accesstoken/
# Used by Insight Agent to alert before the token expires (<14 days warning, <3 days critical).
META_TOKEN_EXPIRES_AT=

# graph.facebook.com (Facebook Login) or graph.instagram.com (Instagram Login).
# Resumable upload only works on graph.facebook.com; graph.instagram.com needs PUBLISH_MODE=ngrok.
GRAPH_HOST=graph.facebook.com
GRAPH_VERSION=v26.0

# resumable (upload the local file directly) or ngrok (expose via tunnel + video_url)
PUBLISH_MODE=resumable

# Required for PUBLISH_MODE=ngrok. Paste the bare token (no <angle brackets> or quotes).
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Google Gemini
GEMINI_API_KEY=

# Insight Agent: salt for hashing comment authors (SHA-256). Raw usernames are never stored.
# Shared secret, same value for all developers, share privately. Changing it breaks
# author matching across existing data.
INSIGHT_AUTHOR_SALT=
